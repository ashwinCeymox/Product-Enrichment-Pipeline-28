# ── Server Port Configuration ──
HOST_WEB_PORT=8083
HOST_API_PORT=8000
HOST_DB_PORT=5433
HOST_REDIS_PORT=6379
HOST_PGWEB_PORT=8081
HOST_STEEL_PORT=3001
HOST_STEEL_DEBUG_PORT=9224

# ── Internal Docker Networking ──
DATABASE_URL=postgresql+psycopg2://pgweb:pgweb@postgres:5432/pgweb
REDIS_URL=redis://redis:6379/0
SECRET_KEY=your-super-secret-key-here

# ── Settings ──
IMAGE_MODEL=google/gemini-2.5-flash-image
LLM_MODEL=deepseek/deepseek-chat
IMAGE_OUTPUT_DIR=output/images

# ── AI Keys (To be filled in the UI or manually) ──
DEEPSEEK_API_KEY=sk-your-deepseek-key
SERPER_API_KEY=your-serper-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
BROWSERBASE_API_KEY=bb_live_your-browserbase-key
SCRAPING_MODEL=openai/gpt-4o-mini
IMAGE_GENERATION_MODEL=google/gemini-2.5-flash-image
